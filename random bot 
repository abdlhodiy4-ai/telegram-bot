# Ma'lumotlar papkasi: Pydroid tozalansa ham o'chmaydigan joy
def tanla_papka():
    nomzodlar = [
        "/storage/emulated/0/KuyNavoBot",
        os.path.join(os.path.dirname(os.path.abspath(__file__)), "data"),
    ]
    for d in nomzodlar:
        try:
            os.makedirs(d, exist_ok=True)
            test = os.path.join(d, ".test")
            with open(test, "w") as f:
                f.write("ok")
            os.remove(test)
            return d
        except Exception:
            continue
    return os.getcwd()


DATA_DIR = tanla_papka()
DATA_FILE = os.path.join(DATA_DIR, "obunachilar.json")                # konkursda qatnashganlar
IG_FILE = os.path.join(DATA_DIR, "instagram_tasdiq.json")             # Instagram tasdiqlagan
BARCHA_FILE = os.path.join(DATA_DIR, "barcha_foydalanuvchilar.json")  # /start yuborganlar
MATN_FILE = os.path.join(DATA_DIR, "matn.json")                       # konkurs matni
log.info("Ma'lumotlar papkasi: %s", DATA_DIR)

lock = threading.Lock()


def yuklash(path):
    if not os.path.exists(path):
        return []
    try:
        with open(path, "r", encoding="utf-8") as f:
            return [int(x) for x in json.load(f)]
    except Exception as e:
        log.error("%s ni o'qishda xato: %s", path, e)
        return []


def saqlash(path, royxat):
    tmp = path + ".tmp"
    with open(tmp, "w", encoding="utf-8") as f:
        json.dump(royxat, f)
    os.replace(tmp, path)


# Tezkorlik uchun ma'lumotlar xotirada saqlanadi
obunachilar = yuklash(DATA_FILE)
ig_tasdiq = set(yuklash(IG_FILE))
barcha = yuklash(BARCHA_FILE)

DEFAULT_MATN = "Siz konkursda qatnashdingiz!"


def matn_yuklash():
    try:
        with open(MATN_FILE, "r", encoding="utf-8") as f:
            return json.load(f)
    except Exception:
        return DEFAULT_MATN


START_MATN = matn_yuklash()


def barchani_qayd_qil(chat_id):
    """/start yuborgan har bir foydalanuvchini saqlaydi."""
    with lock:
        if chat_id not in barcha:
            barcha.append(chat_id)
            saqlash(BARCHA_FILE, barcha)


def obuna_qoshish(chat_id):
    with lock:
        if chat_id not in obunachilar:
            obunachilar.append(chat_id)
            saqlash(DATA_FILE, obunachilar)
            return True
        return False


def ig_belgilash(user_id):
    with lock:
        if user_id not in ig_tasdiq:
            ig_tasdiq.add(user_id)
            saqlash(IG_FILE, list(ig_tasdiq))


def egami(message):
    """Username yoki ID mos kelsa, foydalanuvchi bot egasi hisoblanadi."""
    user = message.from_user
    if (user.username or "").lower() == OWNER_USERNAME.lower():
        return True
    if OWNER_ID and user.id == OWNER_ID:
        return True
    return False


bot = telebot.TeleBot(TOKEN, threaded=True)


def tg_obunachi(user_id):
    """Telegram kanal obunasini tekshiradi. Bot kanalda admin bo'lishi kerak."""
    try:
        m = bot.get_chat_member(TG_KANAL, user_id)
        log.info("Kanal holati (%s): %s", user_id, m.status)
        return m.status in ("creator", "administrator", "member", "restricted")
    except Exception as e:
        log.error("Kanal tekshiruvi xatosi (%s): %s", user_id, e)
        return False


def holat(user_id):
    return tg_obunachi(user_id), user_id in ig_tasdiq


def klaviatura(tg_ok, ig_ok):
    kb = InlineKeyboardMarkup()
    if not tg_ok:
        kb.add(InlineKeyboardButton("📢 Telegram kanalga obuna bo'lish", url=TG_KANAL_URL))
    if not ig_ok:
        kb.add(InlineKeyboardButton("📸 Instagram sahifaga o'tish", url=IG_URL))
        kb.add(InlineKeyboardButton("✅ Instagramga obuna bo'ldim", callback_data="ig_ok"))
    kb.add(InlineKeyboardButton("🔄 Tekshirish", callback_data="tekshir"))
    return kb


MATN_OBUNA = (
    "Konkursda qatnashish uchun quyidagi kanallarga obuna bo'ling, "
    "so'ng \"🔄 Tekshirish\" tugmasini bosing."
)


@bot.message_handler(commands=["start"])
def start(message):
    try:
        cid = message.chat.id
        barchani_qayd_qil(cid)
        tg_ok, ig_ok = holat(message.from_user.id)
        if tg_ok and ig_ok:
            yangi = obuna_qoshish(cid)
            if yangi:
                bot.reply_to(message, START_MATN)
            else:
                bot.reply_to(message, "Siz allaqachon konkursda qatnashyapsiz.")
        else:
            bot.send_message(cid, MATN_OBUNA, reply_markup=klaviatura(tg_ok, ig_ok))
    except Exception as e:
        log.error("/start xatosi: %s", e)


@bot.callback_query_handler(func=lambda c: c.data in ("ig_ok", "tekshir"))
def tugma_bosildi(call):
    try:
        uid = call.from_user.id
        cid = call.message.chat.id
        barchani_qayd_qil(cid)

        if call.data == "ig_ok":
            ig_belgilash(uid)

        tg_ok, ig_ok = holat(uid)

        if tg_ok and ig_ok:
            obuna_qoshish(cid)
            bot.edit_message_text(START_MATN, cid, call.message.message_id)
            bot.answer_callback_query(call.id, "Tayyor!")
        else:
            try:
                bot.edit_message_text(
                    MATN_OBUNA,
                    cid,
                    call.message.message_id,
                    reply_markup=klaviatura(tg_ok, ig_ok),
                )
            except Exception:
                pass
            bot.answer_callback_query(
                call.id,
                "Hali barcha kanallarga obuna bo'lmagansiz.",
                show_alert=True,
            )
    except Exception as e:
        log.error("Tugma xatosi: %s", e)


@bot.message_handler(commands=["almash"])
def almash(message):
    global START_MATN
    if not egami(message):
        bot.reply_to(message, "Bu buyruq faqat bot egasi uchun.")
        return

    parts = (message.text or "").split(maxsplit=1)
    if len(parts) < 2 or not parts[1].strip():
        bot.reply_to(message, "Foydalanish: /almash yangi matn")
        return

    with lock:
        START_MATN = parts[1].strip()
        tmp = MATN_FILE + ".tmp"
        with open(tmp, "w", encoding="utf-8") as f:
            json.dump(START_MATN, f, ensure_ascii=False)
        os.replace(tmp, MATN_FILE)

    bot.reply_to(message, f"Matn o'zgartirildi:\n{START_MATN}")


@bot.message_handler(commands=["tanla"])
def tanla(message):
    if not egami(message):
        bot.reply_to(message, "Bu buyruq faqat bot egasi uchun.")
        return

    with lock:
        nomzodlar = [s for s in obunachilar if s != message.from_user.id]
    if not nomzodlar:
        bot.reply_to(message, "Konkursda qatnashganlar yo'q.")
        return

    tanlangan = random.choice(nomzodlar)

    try:
        chat = bot.get_chat(tanlangan)
        ism = chat.first_name or ""
        familiya = chat.last_name or ""
        username = f"@{chat.username}" if chat.username else "yo'q"
        ism_matni = f"{ism} {familiya}".strip() or "Noma'lum"
    except Exception:
        ism_matni = "Noma'lum"
        username = "yo'q"

    bot.reply_to(
        message,
        f"Tanlangan obunachi:\n"
        f"Ism: {ism_matni}\n"
        f"Username: {username}\n"
        f"ID: {tanlangan}",
    )


@bot.message_handler(commands=["soni"])
