    with lock:
        n = len(obunachilar)
        jami = len(barcha)
    bot.reply_to(
        message,
        f"Konkursda qatnashganlar: {n}\nBotga /start yuborganlar: {jami}",
    )


@bot.message_handler(commands=["royxat"])
def royxat(message):
    if not egami(message):
        bot.reply_to(message, "Bu buyruq faqat bot egasi uchun.")
        return

    with lock:
        royx = list(barcha)
        qatnashganlar = set(obunachilar)
    if not royx:
        bot.reply_to(message, "Ro'yxat bo'sh. Hali hech kim /start yubormagan.")
        return

    satrlar = []
    for i, cid in enumerate(royx, 1):
        try:
            chat = bot.get_chat(cid)
            ism = f"{chat.first_name or ''} {chat.last_name or ''}".strip() or "Noma'lum"
            un = f"@{chat.username}" if chat.username else "yo'q"
        except Exception:
            ism, un = "Noma'lum", "yo'q"
        holati = "✅" if cid in qatnashganlar else "❌"
        satrlar.append(f"{i}. {holati} {ism} | {un} | {cid}")

    # Telegram xabar uzunligi cheklovi (4096 belgi) uchun bo'lib yuboramiz
    joriy = ""
    for satr in satrlar:
        if len(joriy) + len(satr) + 1 > 3900:
            bot.send_message(message.chat.id, joriy)
            joriy = ""
        joriy += satr + "\n"
    if joriy:
        bot.send_message(message.chat.id, joriy)


